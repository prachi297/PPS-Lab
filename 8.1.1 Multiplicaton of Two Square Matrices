def read_matrix(n):
    matrix = []
    for _ in range(n):
        row = list(map(int, input().split()))
        matrix.append(row)
    return matrix

def multiply_matrices(A, B, n):
    result = [[0] * n for _ in range(n)]
    for i in range(n):
        for j in range(n):
            for k in range(n):
                result[i][j] += A[i][k] * B[k][j]
    return result

def main():
    n = int(input("dimension: "))
    print("first matrix:")
    A = read_matrix(n)
    print("second matrix:")
    B = read_matrix(n)

    result = multiply_matrices(A, B, n)

    print("Resultant Matrix:")
    for row in result:
        print(" ".join(map(str, row)))

if __name__ == "__main__":
    main()

