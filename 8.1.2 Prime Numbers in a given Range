def is_prime(num):
    if num < 2:
        return False
    for i in range(2, int(num**0.5) + 1):
        if num % i == 0:
            return False
    return True

def main():
    start = int(input())
    end = int(input())

    primes = [num for num in range(start, end + 1) if is_prime(num)]

    if primes:
        for p in primes:
            print(p)
    else:
        print("No primes")

if __name__ == "__main__":
    main()

