day = int(input())
month = int(input())
year = int(input())

valid = True

# Check valid year
if year <= 0:
    valid = False

# Check valid month
if month < 1 or month > 12:
    valid = False

# Determine days in month
if month in [1,3,5,7,8,10,12]:
    max_day = 31
elif month in [4,6,9,11]:
    max_day = 30
elif month == 2:
    if (year % 400 == 0) or (year % 4 == 0 and year % 100 != 0):
        max_day = 29
    else:
        max_day = 28
else:
    valid = False

# Check valid day
if valid and (day < 1 or day > max_day):
    valid = False

if not valid:
    print("Invalid Date")
else:
    day += 1
    if day > max_day:
        day = 1
        month += 1
        if month > 12:
            month = 1
            year += 1

    print(f"{day:02d}-{month:02d}-{year}")
